{
  "name": "biblioteca-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de domínio único: biblioteca (livros e empréstimos)",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:openapi": "spectral lint docs/openapi.yaml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "k6 run tests/k6/smoke.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@stoplight/spectral-cli": "^6.14.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.15.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.8"
  }
}
